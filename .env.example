# Upstash Redis (Vercel → Storage → Upstash for Redis las crea automáticamente).
# Sin estas variables, en local se usa un almacén en memoria.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Lectura de boletas con IA (Google AI Studio). Sin esta variable, la boleta se lee en el dispositivo.
GEMINI_API_KEY=
# Opcional: otro modelo con visión (por defecto gemma-4-26b-a4b-it).
RECEIPT_MODEL=
