---
import { version } from '../../package.json';
import { es } from '../i18n/es';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  icon?: string;
  nav?: 'court' | 'groups';
}

const { title = es.meta.title, description = es.meta.description, icon = '🏀', nav } = Astro.props;
const sections = [
  { id: 'court', href: '/', label: es.nav.court, emoji: '🏀' },
  { id: 'groups', href: '/cuenta', label: es.nav.groups, emoji: '🧾' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content" />
    <meta name="theme-color" content="#2340C8" />
    <meta name="description" content={description} />
    <meta name="referrer" content="no-referrer" />
    <title>{title}</title>
    <link rel="icon" href={`data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>${icon}</text></svg>`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;800;900&family=Familjen+Grotesk:wght@400;500;600;700&display=swap"
    />
  </head>
  <body>
    <div class="court-lines" aria-hidden="true"></div>

    <header class="masthead">
      <div>
        <p class="eyebrow">{es.brand.tagline}</p>
        <h1 class="wordmark">{es.brand.first} <span>{es.brand.second}</span></h1>
      </div>
      <div class="masthead-actions">
        {
          nav && (
            <nav class="section-nav" aria-label={es.nav.label}>
              {sections.map((section) => (
                <a href={section.href} aria-current={section.id === nav ? 'page' : undefined}>
                  <span aria-hidden="true">{section.emoji}</span> {section.label}
                </a>
              ))}
            </nav>
          )
        }
        <slot name="actions" />
      </div>
    </header>

    <slot />

    <footer class="app-footer">v{version}</footer>
  </body>
</html>
