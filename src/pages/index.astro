---
import Layout from '../components/Layout.astro';
import Progress from '../components/Progress.astro';
import { es } from '../i18n/es';

const { upload, toolbar, game, pay, steps, share, image, history } = es;
---

<Layout>
  <button slot="actions" type="button" class="history-btn" id="openHistory" aria-haspopup="dialog">
    <span>{history.open}</span>
    <span class="history-count" id="historyCount" aria-hidden="true" hidden></span>
    <span class="sr-only" id="historyCountLabel"></span>
  </button>

  <main class="layout">
    <section class="stage-col">
      <label class="dropzone" id="dropzone">
        <input id="file" type="file" accept="image/*" hidden />
        <span class="dropzone-ball" aria-hidden="true">🏀</span>
        <strong>{upload.title}</strong>
        <span>{upload.body}</span>
        <span class="dropzone-note">{upload.note}</span>
      </label>

      <div class="stage-wrap" id="stageWrap" hidden>
        <div class="stage-toolbar">
          <div class="segmented" role="group" aria-label={toolbar.mode}>
            <button type="button" aria-pressed="true" data-mode="pay">{toolbar.pay}</button>
            <button type="button" aria-pressed="false" data-mode="edit">{toolbar.edit}</button>
          </div>
          <div class="toolbar-actions">
            <button type="button" class="ghost" id="peek" aria-pressed="false" title={toolbar.peekTitle}>
              <span aria-hidden="true">👀</span>&nbsp;{toolbar.peek}
            </button>
            <button type="button" class="ghost" id="reroll" title={toolbar.rerollTitle}>
              <span aria-hidden="true">🎲</span>&nbsp;{toolbar.reroll}
            </button>
            <button type="button" class="ghost" id="newPhoto">{upload.changePhoto}</button>
          </div>
        </div>
        <p class="hint" id="hint">{es.hints.initial}</p>
        <p class="blocked-bar" id="blockedBar" hidden>
          <span>{toolbar.blocked} <span id="blockedList" class="blocked-list"></span></span>
          <button type="button" class="link" id="unblock">{toolbar.unblock}</button>
        </p>
        <div class="stage-area" id="stageArea">
          <div class="stage" id="stage">
            <img id="photo" alt={upload.photoAlt} />
            <div class="faces" id="faces"></div>
            <div class="scanning" id="scanning" hidden>
              <span class="scan-bar"></span>
              <p id="scanText">{upload.scanning}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <aside class="panel" id="panel" aria-label={game.panel}>
      <section class="game" id="game">
        <div class="game-head">
          <div class="game-id">
            <h2 class="game-title" id="gameTitle" tabindex="-1">{game.newGame}</h2>
            <p class="game-meta" id="gameMeta"></p>
            <p class="pay-chip" id="payChip" hidden>
              <img id="payChipQr" alt="" hidden />
              <span><span class="pay-chip-label">{pay.chip}</span> <span id="payChipNote"></span></span>
            </p>
          </div>
          <button type="button" class="icon-btn" id="editGame" aria-expanded="true" aria-controls="gameForm" aria-label={game.edit} title={game.edit}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4zM14 6l4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path></svg>
          </button>
        </div>
        <div class="game-form" id="gameForm">
          <div class="field">
            <label for="title">{game.name}</label>
            <input id="title" type="text" placeholder={game.namePlaceholder} maxlength="60" autocomplete="off" />
          </div>
          <div class="field-row">
            <div class="field grow">
              <label for="cost">{game.cost}</label>
              <div class="money-input">
                <input id="currency" type="text" value="S/" maxlength="4" aria-label={game.currency} />
                <input id="cost" type="number" inputmode="decimal" min="0" step="0.5" placeholder="120" />
              </div>
            </div>
            <div class="field">
              <label for="rounding">{game.rounding}</label>
              <select id="rounding">
                <option value="0">{game.noRounding}</option>
                <option value="0.5">{game.roundHalf}</option>
                <option value="1">{game.roundOne}</option>
              </select>
            </div>
          </div>
          <div class="field">
            <label for="payNote">{pay.label} <span class="optional">{pay.optional}</span></label>
            <textarea id="payNote" rows="2" maxlength="160" placeholder={pay.placeholder}></textarea>
          </div>
          <div class="qr-field">
            <img class="qr-preview" id="payQrPreview" alt={pay.qrAlt} hidden />
            <label class="secondary small file-btn">
              <input type="file" id="payQrFile" accept="image/*" class="sr-only" />
              <span id="payQrLabel">{pay.uploadQr}</span>
            </label>
            <button type="button" class="link danger" id="payQrRemove" hidden>{pay.removeQr}</button>
          </div>
          <button type="button" class="secondary small" id="doneGame">{game.done}</button>
        </div>
      </section>

      <ol class="steps" id="steps">
        {[steps.photo, steps.cost, steps.share].map(([action, rest]) => <li><span><strong>{action}</strong> {rest}</span></li>)}
      </ol>

      <div class="progress-wrap" id="progressWrap" hidden>
        <Progress />
      </div>

      <section class="share" id="linkShare" aria-labelledby="shareTitle">
        <div class="section-head">
          <h3 id="shareTitle">{share.title}</h3>
          <span class="sync" id="syncStatus"></span>
        </div>
        <p class="help">{share.help}</p>
        <p class="link-url" id="linkReady" hidden>
          <span class="sr-only">{share.urlLabel}</span>
          <span id="publicUrl"></span>
        </p>
        <details class="more">
          <summary>{share.more}</summary>
          <div class="more-body">
            <label class="check">
              <input type="checkbox" id="includePhoto" checked />
              <span>{share.includePhoto}</span>
            </label>
            <div class="master" id="masterBox" hidden>
              <button type="button" class="secondary small" id="copyMaster">{share.copyMaster}</button>
              <p class="help">{share.masterHelp}</p>
              <button type="button" class="link danger" id="stopLink">{share.stop}</button>
            </div>
          </div>
        </details>
        <p class="export-msg" id="exportMsg" role="status"></p>
      </section>

      <div class="panel-actions">
        <p class="dock-sum" id="dockSum" aria-hidden="true"></p>
        <button type="button" class="primary" id="linkAction" disabled>{share.create}</button>
        <button type="button" class="secondary image-btn" id="download" aria-label={image.save} title={image.save}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0l-4.5-4.5M12 15l4.5-4.5M5 19h14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          <span aria-hidden="true">{image.button}</span>
        </button>
        <button type="button" class="icon-btn lg" id="share" aria-label={image.shareTitle} title={image.shareTitle} hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V4m0 0L7.5 8.5M12 4l4.5 4.5M6 12v7h12v-7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
      </div>
      <p class="sr-only" id="announce" aria-live="polite"></p>
    </aside>
  </main>

  <dialog class="drawer" id="history" aria-labelledby="historyTitle" closedby="any">
    <div class="drawer-body">
      <div class="drawer-head">
        <h2 id="historyTitle">{history.open}</h2>
        <button type="button" class="icon-btn" id="closeHistory" aria-label={history.close}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path></svg>
        </button>
      </div>
      <p class="drawer-summary" id="historySummary"></p>
      <button type="button" class="primary" id="newGame">{game.newGame}</button>
      <div class="drawer-list" id="historyList"></div>
      <p class="drawer-empty" id="historyEmpty">{history.empty}</p>
      <p class="sr-only" id="historyStatus" role="status"></p>
    </div>
  </dialog>

  <script>
    import '../scripts/app.ts';
  </script>
</Layout>
