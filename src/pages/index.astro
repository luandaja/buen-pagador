---
import Layout from '../components/Layout.astro';
import Progress from '../components/Progress.astro';
---

<Layout>
  <button slot="actions" type="button" class="history-btn" id="openHistory" aria-haspopup="dialog">
    <span>Mis partidos</span>
    <span class="history-count" id="historyCount" aria-hidden="true" hidden></span>
    <span class="sr-only" id="historyCountLabel"></span>
  </button>

  <main class="layout">
    <section class="stage-col">
      <!-- Estado vacío -->
      <label class="dropzone" id="dropzone">
        <input id="file" type="file" accept="image/*" hidden />
        <span class="dropzone-ball" aria-hidden="true">🏀</span>
        <strong>Sube la foto del equipo</strong>
        <span>Arrástrala aquí o toca para elegirla. Detectamos las caras y les ponemos un emoji hasta que paguen.</span>
        <span class="dropzone-note">La foto se queda en tu dispositivo.</span>
      </label>

      <!-- Foto con caras -->
      <div class="stage-wrap" id="stageWrap" hidden>
        <div class="stage-toolbar">
          <div class="segmented" role="group" aria-label="Modo">
            <button type="button" aria-pressed="true" data-mode="pay">Marcar pagos</button>
            <button type="button" aria-pressed="false" data-mode="edit">Corregir caras</button>
          </div>
          <div class="toolbar-actions">
            <button type="button" class="ghost" id="peek" aria-pressed="false" title="Quitar los emojis un momento para ver quién es quién">
              <span aria-hidden="true">👀</span>&nbsp;Ver caras
            </button>
            <button type="button" class="ghost" id="reroll" title="Cambiar los emojis">
              <span aria-hidden="true">🎲</span>&nbsp;Otros emojis
            </button>
            <button type="button" class="ghost" id="newPhoto">Cambiar foto</button>
          </div>
        </div>
        <p class="hint" id="hint">Toca una cara cuando esa persona pague.</p>
        <p class="blocked-bar" id="blockedBar" hidden>
          <span>Bloqueados: <span id="blockedList" class="blocked-list"></span></span>
          <button type="button" class="link" id="unblock">Restaurar</button>
        </p>
        <div class="stage-area" id="stageArea">
          <div class="stage" id="stage">
            <img id="photo" alt="Foto del equipo" />
            <div class="faces" id="faces"></div>
            <div class="scanning" id="scanning" hidden>
              <span class="scan-bar"></span>
              <p id="scanText">Buscando caras…</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <aside class="panel" id="panel" aria-label="Partido">
      <section class="game" id="game">
        <div class="game-head">
          <div class="game-id">
            <h2 class="game-title" id="gameTitle" tabindex="-1">Nuevo partido</h2>
            <p class="game-meta" id="gameMeta"></p>
          </div>
          <button type="button" class="icon-btn" id="editGame" aria-expanded="true" aria-controls="gameForm" aria-label="Editar partido" title="Editar partido">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4zM14 6l4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path></svg>
          </button>
        </div>
        <div class="game-form" id="gameForm">
          <div class="field">
            <label for="title">Nombre del partido</label>
            <input id="title" type="text" placeholder="Jueves 9 pm · Cancha del parque" maxlength="60" autocomplete="off" />
          </div>
          <div class="field-row">
            <div class="field grow">
              <label for="cost">¿Cuánto costó la cancha?</label>
              <div class="money-input">
                <input id="currency" type="text" value="S/" maxlength="4" aria-label="Moneda" />
                <input id="cost" type="number" inputmode="decimal" min="0" step="0.5" placeholder="120" />
              </div>
            </div>
            <div class="field">
              <label for="rounding">Redondear cuota</label>
              <select id="rounding">
                <option value="0">Sin redondear</option>
                <option value="0.5">A 0.50</option>
                <option value="1">A 1</option>
              </select>
            </div>
          </div>
          <button type="button" class="secondary small" id="doneGame">Listo</button>
        </div>
      </section>

      <ol class="steps" id="steps">
        <li><span><strong>Sube la foto</strong> del equipo.</span></li>
        <li><span><strong>Pon el costo</strong> de la cancha.</span></li>
        <li><span><strong>Comparte el link</strong> y marca a cada uno cuando pague.</span></li>
      </ol>

      <div class="progress-wrap" id="progressWrap" hidden>
        <Progress />
      </div>

      <section class="share" id="linkShare" aria-labelledby="shareTitle">
        <div class="section-head">
          <h3 id="shareTitle">Compartir con el grupo</h3>
          <span class="sync" id="syncStatus"></span>
        </div>
        <p class="help">Ven la foto y quién pagó, y se actualiza solo. Nadie más puede editar.</p>
        <p class="link-url" id="linkReady" hidden>
          <span class="sr-only">Link del grupo:</span>
          <span id="publicUrl"></span>
        </p>
        <details class="more">
          <summary>Más opciones</summary>
          <div class="more-body">
            <label class="check">
              <input type="checkbox" id="includePhoto" checked />
              <span>La imagen que guardas incluye la foto</span>
            </label>
            <div class="master" id="masterBox" hidden>
              <button type="button" class="secondary small" id="copyMaster">Copiar link para editar</button>
              <p class="help">Ábrelo en otro celular para seguir marcando pagos. No lo mandes al grupo.</p>
              <button type="button" class="link danger" id="stopLink">Desactivar link del grupo</button>
            </div>
          </div>
        </details>
        <p class="export-msg" id="exportMsg" role="status"></p>
      </section>

      <div class="panel-actions">
        <p class="dock-sum" id="dockSum" aria-hidden="true"></p>
        <button type="button" class="primary" id="linkAction" disabled>Crear link</button>
        <button type="button" class="secondary image-btn" id="download" aria-label="Guardar imagen" title="Guardar imagen">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0l-4.5-4.5M12 15l4.5-4.5M5 19h14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          <span aria-hidden="true">Imagen</span>
        </button>
        <button type="button" class="icon-btn lg" id="share" aria-label="Compartir imagen" title="Compartir imagen" hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V4m0 0L7.5 8.5M12 4l4.5 4.5M6 12v7h12v-7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
      </div>
      <p class="sr-only" id="announce" aria-live="polite"></p>
    </aside>
  </main>

  <dialog class="drawer" id="history" aria-labelledby="historyTitle" closedby="any">
    <div class="drawer-body">
    <div class="drawer-head">
      <h2 id="historyTitle">Mis partidos</h2>
      <button type="button" class="icon-btn" id="closeHistory" aria-label="Cerrar">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path></svg>
      </button>
    </div>
    <p class="drawer-summary" id="historySummary"></p>
    <button type="button" class="primary" id="newGame">Nuevo partido</button>
    <div class="drawer-list" id="historyList"></div>
    <p class="drawer-empty" id="historyEmpty">Todavía no hay partidos guardados. Cuando subas una foto, el partido aparece aquí.</p>
    <p class="sr-only" id="historyStatus" role="status"></p>
    </div>
  </dialog>

  <script>
    import '../scripts/app.ts';
  </script>
</Layout>
