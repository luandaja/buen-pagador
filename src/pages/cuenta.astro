---
import Layout from '../components/Layout.astro';
import { es } from '../i18n/es';
import '../styles/group.css';
---

<Layout title={es.group.metaTitle} description={es.group.metaDescription} icon="🧾" nav="groups">
  <main class="layout group-layout" id="app">
    <p class="group-loading">{es.group.loading}</p>
  </main>

  <script>
    import { mountGroupApp } from '../islands/group/GroupApp';

    mountGroupApp(document.getElementById('app')!);
  </script>
</Layout>
